# صفحة الأمنيات السرية (/wishes)
# كود فتح الصفحة — القيمة الافتراضية في الكود هي toqa.
# على Vercel: Project → Settings → Environment Variables → WISHES_CODE = toqa
WISHES_CODE=toqa

# مسار ملف بديل لتخزين الأمنيات لو مفيش قاعدة بيانات (اختياري).
# الافتراضي: data/wishes.json محليًا، وملف مؤقت على Vercel.
# WISHES_FILE=data/wishes.json

# رابط قاعدة بيانات MySQL (اختياري). لو مش متوفّر، النظام بيشتغل بملف JSON.
# DATABASE_URL=mysql://user:password@host:3306/toqa
